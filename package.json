{
  "name": "@dboeckli/apifirst-sb",
  "version": "1.1.0",
  "dependencies": {
    "@redocly/cli": "2.5.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "private": false,
  "scripts": {
    "start": "node node_modules/@redocly/cli/bin/cli.js preview-docs",
    "build": "node node_modules/@redocly/cli/bin/cli.js bundle openapi/openapi.yaml -o dist/bundle.yaml",
    "build:docs": "node node_modules/@redocly/cli/bin/cli.js build-docs openapi/openapi.yaml -o _site/index.html",
    "test": "node node_modules/@redocly/cli/bin/cli.js lint"
  }
}
